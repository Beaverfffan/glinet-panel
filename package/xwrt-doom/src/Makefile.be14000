# doomgeneric / GL-BE14000 平台构建（交叉编译用）
#
# 与上游 Makefile 的差别：
#   - 不编 doomgeneric_xlib.c（它自带 main()），改由 doom_be14000.c 提供 main()
#   - 分辨率锁 320x200（Doom 原生），上屏时再拉伸到面板 320x240
#   - 关掉 -DSNDSERV、-lX11
#
# 两种用法：
#   1) 手写交叉编译（tools/build-doom.sh）：直接调本文件，用 src-link 的 staging_dir
#   2) OpenWrt 包内部（package/xwrt-doom/Makefile）：由 $(TARGET_CC)/$(TARGET_CFLAGS)
#      驱动。⚠️ **必须把工具链参数塞进 CFLAGS_EXTRA/LDFLAGS_EXTRA，不能覆盖 CFLAGS** ——
#      make 的命令行变量优先级最高，写成 CFLAGS=... 会把下面那串 -DNORMALUNIX
#      -DLINUX -fsigned-char 全抹掉，然后上游代码会因为缺宏编出一堆奇怪错误。

CC ?= gcc
CFLAGS_EXTRA ?=
LDFLAGS_EXTRA ?=
DRM_INC ?=
DRM_LIB ?=

CFLAGS += -O2 -Wall -Wno-unused-result
CFLAGS += -DNORMALUNIX -DLINUX -D_DEFAULT_SOURCE -fsigned-char
CFLAGS += -DDOOMGENERIC_RESX=320 -DDOOMGENERIC_RESY=200
CFLAGS += $(DRM_INC) $(CFLAGS_EXTRA)
LDFLAGS += -Wl,--gc-sections $(LDFLAGS_EXTRA)
LIBS += -lm $(DRM_LIB)

OBJDIR = build-be14000
OUTPUT = doom

SRC_DOOM = \
	dummy.o am_map.o doomdef.o doomstat.o dstrings.o d_event.o d_items.o \
	d_iwad.o d_loop.o d_main.o d_mode.o d_net.o f_finale.o f_wipe.o g_game.o \
	hu_lib.o hu_stuff.o info.o i_cdmus.o i_endoom.o i_joystick.o i_scale.o \
	i_sound.o i_system.o i_timer.o memio.o m_argv.o m_bbox.o m_cheat.o \
	m_config.o m_controls.o m_fixed.o m_menu.o m_misc.o m_random.o p_ceilng.o \
	p_doors.o p_enemy.o p_floor.o p_inter.o p_lights.o p_map.o p_maputl.o \
	p_mobj.o p_plats.o p_pspr.o p_saveg.o p_setup.o p_sight.o p_spec.o \
	p_switch.o p_telept.o p_tick.o p_user.o r_bsp.o r_data.o r_draw.o \
	r_main.o r_plane.o r_segs.o r_sky.o r_things.o sha1.o sounds.o \
	statdump.o st_lib.o st_stuff.o s_sound.o tables.o v_video.o wi_stuff.o \
	w_checksum.o w_file.o w_main.o w_wad.o z_zone.o w_file_stdc.o i_input.o \
	i_video.o doomgeneric.o

SRC_PORT = doom_be14000.o panel_out.o ovl.o tinput.o

OBJS = $(addprefix $(OBJDIR)/, $(SRC_DOOM) $(SRC_PORT))

all: $(OUTPUT)

clean:
	rm -rf $(OBJDIR) $(OUTPUT)

$(OUTPUT): $(OBJS)
	@echo "[LINK] $@"
	$(CC) $(CFLAGS) $(LDFLAGS) $(OBJS) -o $(OUTPUT) $(LIBS)
	@$(CROSS_COMPILE)size $(OUTPUT) 2>/dev/null || size $(OUTPUT) 2>/dev/null || true

$(OBJS): | $(OBJDIR)

$(OBJDIR):
	mkdir -p $(OBJDIR)

$(OBJDIR)/%.o: %.c
	@echo "[CC]   $<"
	@$(CC) $(CFLAGS) -c $< -o $@

.PHONY: all clean
