msgid "Statistics Panel Screen"
msgstr "统计面板屏幕"

msgid "Settings for the minimal statistics panel (xwrt-panel) of the GL-BE10000 / GL-BE14000. The panel shows WAN usage, connected clients and WiFi status. Changes are applied to /etc/config/xwrt_panel and the panel service is restarted on \"Save & Apply\"."
msgstr "GL-BE10000 / GL-BE14000 极简统计面板（xwrt-panel）设置。面板显示 WAN 用量、已连接客户端和 WiFi 状态。修改写入 /etc/config/xwrt_panel，点击「保存并应用」后面板服务会重启。"

msgid "Panel service"
msgstr "面板服务"

msgid "Service state"
msgstr "服务状态"

msgid "running"
msgstr "运行中"

msgid "not running"
msgstr "未运行"

msgid "Control"
msgstr "控制"

msgid "Restart panel"
msgstr "重启面板"

msgid "Stop"
msgstr "停止"

msgid "Service action \"%s\" %s"
msgstr "服务操作「%s」%s"

msgid "succeeded"
msgstr "成功"

msgid "failed"
msgstr "失败"

msgid "Display"
msgstr "显示"

msgid "Brightness"
msgstr "亮度"

msgid "Panel backlight brightness, 10 to 100 percent."
msgstr "面板背光亮度，10 到 100%。"

msgid "Page rotation (s)"
msgstr "自动翻页（秒）"

msgid "Automatically switch to the next page every N seconds. Set to 0 to only change pages by swiping."
msgstr "每隔 N 秒自动切换到下一页。设为 0 则只能通过滑动翻页。"

msgid "Blank after (min)"
msgstr "息屏时间（分钟）"

msgid "Minutes without touch before the backlight turns off. Set to 0 to keep the screen always on. Any touch wakes the panel."
msgstr "无触摸操作多少分钟后关闭背光。设为 0 则屏幕常亮。任意触摸可唤醒面板。"

msgid "Pages"
msgstr "页面"

msgid "At least one page must stay enabled."
msgstr "至少保留一个页面。"

msgid "Usage"
msgstr "用量"

msgid "WAN up/down rates, totals and a scrolling rate graph."
msgstr "WAN 上下行速率、累计总量与滚动速率图。"

msgid "Clients"
msgstr "客户端"

msgid "List of DHCP leases and snooped clients."
msgstr "DHCP 租约与侦测到的客户端列表。"

msgid "WiFi"
msgstr "WiFi"

msgid "Wireless networks with band, encryption and station count."
msgstr "无线网络列表，含频段、加密方式与已连接终端数。"
